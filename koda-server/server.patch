new file mode 100644
index 0000000..e5cd804
--- /dev/null
+++ b/server/test/asset-metadata-lock.helper.ts
@@ -0,0 +1,46 @@
+import { createPostgres } from '@immich/sql-tools';
+import { Sql, TransactionSql } from 'postgres';
+import { AssetMetadataLocks } from 'src/utils/asset-metadata-lock';
+
+export const deferred = () => {
+  let resolve!: () => void;
+  const promise = new Promise<void>((done) => (resolve = done));
+  return { promise, resolve };
+};
+
+// A transactional lock backend for unit tests. Set KODA_TEST_DATABASE_URL to
+// exercise the exact same tests against independent real PostgreSQL sessions.
+export const lockHarness = () => {
+  const tails = new Map<string, Promise<void>>();
+  const locks: AssetMetadataLocks[] = [];
+  const create = () => {
+    const url = process.env.KODA_TEST_DATABASE_URL;
+    const pool = url
+      ? createPostgres({ connection: { connectionType: 'url', url }, maxConnections: 4 })
+      : ({
+          async begin(callback: (sql: TransactionSql) => Promise<unknown>) {
+            const release: (() => void)[] = [];
+            const transaction = async (_strings: TemplateStringsArray, key: string) => {
+              const before = tails.get(key) ?? Promise.resolve();
+              const after = deferred();
+              tails.set(key, after.promise);
+              await before;
+              release.push(after.resolve);
+              return [];
+            };
+            try {
+              return await callback(transaction as unknown as TransactionSql);
+            } finally {
+              for (const done of release.toReversed()) {
+                done();
+              }
+            }
+          },
+          async end() {},
+        } as unknown as Sql);
+    const lock = new AssetMetadataLocks(pool);
+    locks.push(lock);
+    return lock;
+  };
+  return { create, close: () => Promise.all(locks.map((lock) => lock.close())) };
+};
