@@ -0,0 +1,28 @@
+import { LoggingRepository } from 'src/repositories/logging.repository';
+import { MetadataRepository } from 'src/repositories/metadata.repository';
+
+describe('metadata I/O failures', () => {
+  const logger = { setContext() {}, warn: vi.fn() } as unknown as LoggingRepository;
+  let sut: MetadataRepository;
+  beforeEach(() => {
+    sut = new MetadataRepository(logger);
+  });
+  afterEach(async () => {
+    await sut.teardown();
+  });
+
+  it('propagates failed writes so the caller cannot unlock unpersisted fields', async () => {
+    vi.spyOn(sut['exiftool'], 'write').mockRejectedValue(new Error('write failed'));
+    await expect(sut.writeTags('/photo.xmp', { TagsList: ['tag'] })).rejects.toThrow('write failed');
+  });
+
+  it('does not treat a failed known-sidecar read as an empty tag list', async () => {
+    vi.spyOn(sut['exiftool'], 'read').mockRejectedValue(new Error('read failed'));
+    await expect(sut.readTags('/photo.xmp', { throwOnError: true })).rejects.toThrow('read failed');
+  });
+
+  it('retains the existing optional-read behavior for media without readable EXIF', async () => {
+    vi.spyOn(sut['exiftool'], 'read').mockRejectedValue(new Error('unsupported EXIF'));
+    await expect(sut.readTags('/photo.raw')).resolves.toEqual({});
+  });
+});
