index 0000000..4d2e97b
--- /dev/null
+++ b/server/src/utils/asset-metadata-lock.spec.ts
@@ -0,0 +1,68 @@
+/* eslint-disable @typescript-eslint/require-await -- Asynchronous fakes model repository and job contracts. */
+import { setTimeout } from 'node:timers/promises';
+import { deferred, lockHarness } from 'test/asset-metadata-lock.helper';
+
+describe('asset metadata coordination across workers', () => {
+  let harness: ReturnType<typeof lockHarness>;
+  beforeEach(() => (harness = lockHarness()));
+  afterEach(async () => {
+    await harness.close();
+  });
+
+  it('serializes the same asset but lets a different asset finish', async () => {
+    const api = harness.create();
+    const worker = harness.create();
+    const entered = deferred();
+    const finish = deferred();
+    const events: string[] = [];
+    const first = api.run(['photo'], async () => {
+      events.push('first');
+      entered.resolve();
+      await finish.promise;
+    });
+    await entered.promise;
+    const second = worker.run(['photo'], async () => {
+      events.push('second');
+    });
+    await worker.run(['other-photo'], async () => {
+      events.push('other');
+    });
+    const during = [...events];
+    finish.resolve();
+    await Promise.all([first, second]);
+    expect(during).toEqual(['first', 'other']);
+    expect(events).toEqual(['first', 'other', 'second']);
+  });
+
+  it('sorts overlapping batches so inverse caller order cannot deadlock', async () => {
+    const a = harness.create();
+    const b = harness.create();
+    let active = 0;
+    let maxActive = 0;
+    const critical = async () => {
+      maxActive = Math.max(maxActive, ++active);
+      await setTimeout(10);
+      active--;
+    };
+    await Promise.all([a.run(['b', 'a', 'b'], critical), b.run(['a', 'b'], critical)]);
+    expect(maxActive).toBe(1);
+  });
+
+  it('releases database locks after an exception', async () => {
+    const a = harness.create();
+    const b = harness.create();
+    await expect(
+      a.run(['photo'], async () => {
+        throw new Error('disk failed');
+      }),
+    ).rejects.toThrow('disk failed');
+    await expect(b.run(['photo'], async () => 'recovered')).resolves.toBe('recovered');
+  });
+
+  it('allows a nested subset and rejects acquiring an unrelated child asset', async () => {
+    const a = harness.create();
+    await expect(a.run(['PHOTO', 'other'], () => a.run(['photo'], async () => 'ok'))).resolves.toBe('ok');
+    await expect(a.run(['photo'], () => a.run(['motion'], async () => 'bad'))).rejects.toThrow('Nested metadata locks');
+    await expect(a.run(['motion'], async () => 'released')).resolves.toBe('released');
+  });
+});
diff --git a/server/src/utils/asset-metadata-lock.ts b/server/src/utils/asset-metadata-lock.ts
new file mode 100644
index 0000000..bd3ce64
--- /dev/null
+++ b/server/src/utils/asset-metadata-lock.ts
@@ -0,0 +1,48 @@
+import AsyncLock from 'async-lock';
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { Sql } from 'postgres';
+
+/** Cross-worker serialization for one asset's metadata and file paths.
+ *
+ * The supplied pool is used only for locks. Holding a lock must not reserve a
+ * connection from the query pool: waiting jobs could otherwise exhaust the
+ * pool needed by the current lock holder. Transaction locks are released on
+ * success, failure, disconnect, and worker shutdown without manual unlocks.
+ */
+export class AssetMetadataLocks {
+  private readonly local = new AsyncLock({ maxPending: 10_000 });
+  private readonly held = new AsyncLocalStorage<ReadonlySet<string>>();
+
+  constructor(private readonly pool: Sql) {}
+
+  async run<T>(assetIds: string[], callback: () => Promise<T>): Promise<T> {
+    const ids = [...new Set(assetIds.map((id) => id.toLowerCase()))].sort();
+    if (ids.length === 0) {
+      return callback();
+    }
+
+    const held = this.held.getStore();
+    if (held) {
+      if (ids.every((id) => held.has(id))) {
+        return callback();
+      }
+      // Acquiring another asset while holding a lock can reverse the global
+      // order. Motion-photo extraction runs its child job after releasing the
+      // parent lock instead.
+      throw new Error('Nested metadata locks must be a subset of the held asset IDs');
+    }
+
+    return this.local.acquire(ids, async () => {
+      return (await this.pool.begin(async (transaction) => {
+        for (const id of ids) {
+          await transaction`SELECT pg_advisory_xact_lock(hashtextextended(${'immich:asset-metadata:' + id}, 0))`;
+        }
+        return this.held.run(new Set(ids), callback);
+      })) as T;
+    });
+  }
+
+  async close() {
+    await this.pool.end();
+  }
+}
