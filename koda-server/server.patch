diff --git a/server/src/services/metadata-ordering.spec.ts b/server/src/services/metadata-ordering.spec.ts
new file mode 100644
index 0000000..987a046
--- /dev/null
+++ b/server/src/services/metadata-ordering.spec.ts
@@ -0,0 +1,237 @@
+/* eslint-disable @typescript-eslint/require-await -- Asynchronous fakes model repository and job contracts. */
+import { Stats } from 'node:fs';
+import { setTimeout } from 'node:timers/promises';
+import { AssetFileType, AssetPathType } from 'src/enum';
+import { MetadataService } from 'src/services/metadata.service';
+import { StorageTemplateService } from 'src/services/storage-template.service';
+import { TagService } from 'src/services/tag.service';
+import { deferred, lockHarness } from 'test/asset-metadata-lock.helper';
+import { AssetFactory } from 'test/factories/asset.factory';
+import { authStub } from 'test/fixtures/auth.stub';
+import { tagStub } from 'test/fixtures/tag.stub';
+import { getForMetadataExtraction, getForSidecarWrite, getForStorageTemplate } from 'test/mappers';
+import { getMocks, newTestService, ServiceOverrides } from 'test/utils';
+
+// Deterministic versions of the failing sequences in the Koda server trace.
+// Repository mocks model current DB state; the production service methods and
+// cross-worker guard execute unchanged. The same tests can use real PostgreSQL.
+describe('metadata ordering regressions', () => {
+  let harness: ReturnType<typeof lockHarness>;
+  beforeEach(() => (harness = lockHarness()));
+  afterEach(async () => {
+    await harness.close();
+  });
+
+  const setup = () => {
+    const mocks = getMocks();
+    const apiLock = harness.create();
+    const jobLock = harness.create();
+    const apiDb = { ...mocks.database, withAssetMetadataLock: apiLock.run.bind(apiLock) };
+    const jobDb = { ...mocks.database, withAssetMetadataLock: jobLock.run.bind(jobLock) };
+    const api = newTestService(TagService, { ...mocks, database: apiDb } as unknown as ServiceOverrides).sut;
+    const worker = newTestService(MetadataService, { ...mocks, database: jobDb } as unknown as ServiceOverrides).sut;
+    const mover = newTestService(StorageTemplateService, {
+      ...mocks,
+      database: jobDb,
+    } as unknown as ServiceOverrides).sut;
+    const asset = AssetFactory.from().file({ type: AssetFileType.Sidecar, path: '/data/photo.jpg.xmp' }).exif().build();
+    const state = { tags: [] as string[], links: [] as string[], locked: [] as string[], sidecar: [] as string[] };
+    mocks.access.tag.checkOwnerAccess.mockResolvedValue(new Set(['tag-1']));
+    mocks.access.asset.checkOwnerAccess.mockResolvedValue(new Set([asset.id]));
+    mocks.assetJob.getForMetadataExtraction.mockImplementation(async () => getForMetadataExtraction(asset));
+    mocks.assetJob.getForSidecarWriteJob.mockImplementation(async () => {
+      const row = getForSidecarWrite(asset);
+      row.exifInfo.tags = [...state.tags];
+      return row;
+    });
+    mocks.assetJob.getLockedPropertiesForMetadataExtraction.mockImplementation(
+      async () => [...state.locked] as ['tags'],
+    );
+    mocks.metadata.readTags.mockImplementation(async (path) =>
+      path.endsWith('.xmp') ? { TagsList: [...state.sidecar] } : {},
+    );
+    mocks.metadata.writeTags.mockImplementation(async (_path, tags) => {
+      if (tags.TagsList !== undefined) {
+        state.sidecar = (tags.TagsList ?? []) as string[];
+      }
+    });
+    mocks.asset.unlockProperties.mockImplementation(async (_id, fields) => {
+      state.locked = state.locked.filter((field) => !fields.includes(field as 'tags'));
+      return [];
+    });
+    mocks.storage.stat.mockResolvedValue({
+      size: 1234,
+      mtime: new Date(),
+      mtimeMs: Date.now(),
+      birthtimeMs: Date.now(),
+    } as Stats);
+    mocks.tag.getAssetIds.mockImplementation(async () => new Set(state.links.length > 0 ? [asset.id] : []));
+    mocks.tag.addAssetIds.mockImplementation(async () => {
+      state.links = ['tag-1'];
+    });
+    mocks.asset.getForUpdateTags.mockImplementation(async () => ({ tags: state.links.map((value) => ({ value })) }));
+    mocks.asset.upsertExif.mockImplementation(async ({ exif, lockedPropertiesBehavior }) => {
+      if (exif.tags !== undefined && (lockedPropertiesBehavior !== 'skip' || !state.locked.includes('tags'))) {
+        state.tags = [...((exif.tags as string[]) ?? [])];
+      }
+      if (lockedPropertiesBehavior === 'append') {
+        state.locked = [...new Set([...state.locked, ...((exif.lockedProperties as string[]) ?? [])])];
+      }
+    });
+    mocks.asset.getForMetadataExtractionTags.mockImplementation(async () => ({ tags: state.tags }));
+    mocks.tag.upsertValue.mockImplementation(async ({ value }) => ({
+      ...tagStub.tag,
+      id: value,
+      value,
+      updateId: 'tag-update',
+      userId: asset.ownerId,
+    }));
+    mocks.tag.replaceAssetTags.mockImplementation(async (_id, tags) => {
+      state.links = tags;
+      return [];
+    });
+    return { api, worker, mover, mocks, asset, state };
+  };
+
+  it('does not let an old sidecar read erase a tag after a writer unlocks it', async () => {
+    const { worker, mocks, asset, state } = setup();
+    state.tags = state.links = ['tag-1'];
+    state.locked = ['tags'];
+    const read = deferred();
+    const resume = deferred();
+    mocks.metadata.readTags.mockImplementation(async (path) => {
+      if (!path.endsWith('.xmp')) {
+        return {};
+      }
+      const tags = [...state.sidecar];
+      read.resolve();
+      await resume.promise;
+      return { TagsList: tags };
+    });
+    const extraction = worker.handleMetadataExtraction({ id: asset.id });
+    await read.promise;
+    const write = worker.handleSidecarWrite({ id: asset.id });
+    await setTimeout(50);
+    resume.resolve();
+    await Promise.all([extraction, write]);
+    expect(state.tags).toEqual(['tag-1']);
+    expect(state.links).toEqual(['tag-1']);
+    expect(state.sidecar).toEqual(['tag-1']);
+  });
+
+  it('keeps tag relation insertion and EXIF protection together', async () => {
+    const { api, worker, mocks, asset, state } = setup();
+    const inserted = deferred();
+    const resume = deferred();
+    mocks.tag.addAssetIds.mockImplementation(async () => {
+      state.links = ['tag-1'];
+      inserted.resolve();
+      await resume.promise;
+    });
+    const tag = api.addAssets(authStub.admin, 'tag-1', { ids: [asset.id] });
+    await inserted.promise;
+    const extraction = worker.handleMetadataExtraction({ id: asset.id });
+    await setTimeout(50);
+    resume.resolve();
+    await Promise.all([tag, extraction]);
+    expect(state.tags).toEqual(['tag-1']);
+    expect(state.links).toEqual(['tag-1']);
+    await worker.handleSidecarWrite({ id: asset.id });
+    expect(state.sidecar).toEqual(['tag-1']);
+  });
+
+  it('cannot clear a new tag lock using an older writer snapshot', async () => {
+    const { api, worker, mocks, asset, state } = setup();
+    state.locked = ['description'];
+    const snapshot = deferred();
+    const resume = deferred();
+    const originalRead = mocks.assetJob.getForSidecarWriteJob.getMockImplementation()!;
+    mocks.assetJob.getForSidecarWriteJob.mockImplementationOnce(async (id) => {
+      const row = await originalRead(id);
+      snapshot.resolve();
+      await resume.promise;
+      return row;
+    });
+    const write = worker.handleSidecarWrite({ id: asset.id });
+    await snapshot.promise;
+    const tag = api.addAssets(authStub.admin, 'tag-1', { ids: [asset.id] });
+    await setTimeout(50);
+    resume.resolve();
+    await Promise.all([write, tag]);
+    await worker.handleSidecarWrite({ id: asset.id });
+    await worker.handleMetadataExtraction({ id: asset.id });
+    expect(state.tags).toEqual(['tag-1']);
+    expect(state.links).toEqual(['tag-1']);
+    expect(state.sidecar).toEqual(['tag-1']);
+  });
+
+  it('moves a sidecar created while a storage job was waiting', async () => {
+    const { worker, mover, mocks, asset } = setup();
+    asset.files = [];
+    const stale = getForStorageTemplate(asset);
+    const writing = deferred();
+    const resume = deferred();
+    mocks.assetJob.getLockedPropertiesForMetadataExtraction.mockResolvedValue(['description']);
+    mocks.metadata.writeTags.mockImplementation(async () => {
+      writing.resolve();
+      await resume.promise;
+    });
+    mocks.asset.upsertFile.mockImplementation(async (file) => {
+      asset.files = [
+        {
+          ...file,
+          id: 'sidecar',
+          isEdited: false,
+          isProgressive: false,
+          isTransparent: false,
+          createdAt: new Date(),
+          updatedAt: new Date(),
+          updateId: 'sidecar-update',
+        },
+      ];
+    });
+    mocks.assetJob.getForStorageTemplateJob.mockImplementation(async () => getForStorageTemplate(asset));
+    const moved: string[] = [];
+    vi.spyOn(mover['storageCore'], 'moveFile').mockImplementation(async (file) => {
+      moved.push(file.pathType);
+    });
+    vi.spyOn(mover as unknown as { getTemplatePath: () => Promise<string> }, 'getTemplatePath').mockResolvedValue(
+      '/new/photo.jpg',
+    );
+    const write = worker.handleSidecarWrite({ id: asset.id });
+    await writing.promise;
+    const move = mover.moveAsset(stale, { filename: 'photo.jpg', storageLabel: null });
+    await setTimeout(50);
+    resume.resolve();
+    await Promise.all([write, move]);
+    expect(moved).toEqual([AssetPathType.Original, AssetFileType.Sidecar]);
+  });
+
+  it('preserves field protection when a sidecar write fails', async () => {
+    const { worker, mocks, asset, state } = setup();
+    state.tags = ['tag-1'];
+    state.locked = ['tags'];
+    mocks.metadata.writeTags.mockRejectedValue(new Error('disk unavailable'));
+    await expect(worker.handleSidecarWrite({ id: asset.id })).rejects.toThrow('disk unavailable');
+    expect(mocks.asset.unlockProperties).not.toHaveBeenCalled();
+    expect(state.locked).toEqual(['tags']);
+  });
+
+  it('releases the still-photo lock before extracting its motion asset', async () => {
+    const { worker, mocks, asset } = setup();
+    const seen: string[] = [];
+    vi.spyOn(
+      worker as unknown as { extractMetadata: (data: { id: string }, motion: string[]) => Promise<undefined> },
+      'extractMetadata',
+    ).mockImplementation(async (data: { id: string }, motion: string[]) => {
+      seen.push(data.id);
+      if (data.id === asset.id) {
+        motion.push('motion-child');
+      }
+      return undefined as never;
+    });
+    await worker.handleMetadataExtraction({ id: asset.id });
+    expect(seen).toEqual([asset.id, 'motion-child']);
+    expect(mocks.job.queue).toHaveBeenCalledWith(expect.objectContaining({ data: { id: 'motion-child' } }));
+  });
+});
